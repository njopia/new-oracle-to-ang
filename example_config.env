# Archivo de ejemplo de configuración de variables de entorno
# Copia este archivo y personaliza las rutas según tu instalación
# Luego ejecuta: source example_config.env

# ===== ORACLE FORMS =====
# Ruta de instalación de Oracle Forms
# Ejemplos comunes:
#   Linux: /opt/oracle/middleware/forms
#   Linux: /u01/app/oracle/product/12.2.1/forms
#   Windows: C:/Oracle/Middleware/Oracle_FRHome1
export ORACLE_HOME=/opt/oracle/middleware/forms

# Ruta donde están los formularios (.fmb, .pll, etc.)
export FORMS_PATH=$ORACLE_HOME/forms

# ===== JAVA =====
# Ruta de instalación de Java
# Para encontrar: readlink -f $(which java) | sed "s:/bin/java::"
# Ejemplos comunes:
#   Linux: /usr/lib/jvm/java-8-openjdk-amd64
#   Linux: /usr/lib/jvm/java-11-openjdk-amd64
#   macOS: /Library/Java/JavaVirtualMachines/jdk1.8.0_XXX.jdk/Contents/Home
export JAVA_HOME=/usr/lib/jvm/java-8-openjdk-amd64

# ===== PATH Y LIBRERÍAS =====
# Añadir binarios al PATH
export PATH=$ORACLE_HOME/bin:$JAVA_HOME/bin:$PATH

# Librerías compartidas (Linux)
export LD_LIBRARY_PATH=$ORACLE_HOME/lib:$LD_LIBRARY_PATH

# ===== CONFIGURACIÓN ADICIONAL (OPCIONAL) =====
# Idioma y codificación
export NLS_LANG=AMERICAN_AMERICA.UTF8

# Directorio de trabajo para Oracle Forms
# export FORMS_WEB_CONFIG_FILE=$ORACLE_HOME/forms/server/formsweb.cfg

# ===== VERIFICACIÓN =====
# Descomentar para verificar al cargar este archivo
# echo "ORACLE_HOME: $ORACLE_HOME"
# echo "JAVA_HOME: $JAVA_HOME"
# which frmf2xml
# java -version
